# ----- Node / Vite files -----
node_modules/
dist/
.vite/
.env
.env.local

# ----- Python / FastAPI files -----
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.sqlite3
*.db

# ----- Índice RAG local (regenerable, se indexa al subir el Excel) -----
backend/data/rag/

# ----- Caché de la base de conocimiento (bundle STIX de MITRE, ~50 MB) -----
backend/data/kb_cache/

# ----- Configuración local de la IA (panel «Opciones IA», específica de la máquina) -----
backend/data/ai_config.json

# ----- Memoria de criterio aprendida (ejemplos few-shot, datos del analista) -----
# Es el «cerebro aprendido» de la máquina: regenerable y específico de quien
# la usa, igual que ai_config.json. Se puede vaciar desde el panel.
backend/data/feedback.json

# ----- Fichas candidatas de ataque (fase 3, decisiones del analista) -----
# Borradores pendientes/aprobados/rechazados: datos, no código. Se revisan
# desde el panel «Correlaciones ATT&CK» y el catálogo real es knowledge/.
backend/data/attack_cards_candidates.json

# ----- Estado interno de las herramientas de agente -----
.superpowers/

# ----- Planificación interna local (specs, planes TDD y notas del flujo de trabajo) -----
# Se trabaja en local con el asistente; no forma parte de la app que usa quien clona.
docs/superpowers/

# ----- OS / editor files -----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ----- Bocetos de diseño (carpeta temporal de trabajo) -----
bocetos_graficos_test/

# ----- Logs -----
*.log

# ----- Corridas del harness de evaluación (local, regenerable) -----
backend/eval/runs/
backend/data/analyses/
